{
  "manifest_version": 3,
  "name": "Yuko ExoCognition",
  "version": "2.4",
  "description": "Browser to Local chat marshalling framework",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:9091/*"
  ],
  "action": {
    "default_title": "Yuko ExoSynthetic Thinking",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.chatgpt.com/*", "*://*.claude.ai/*", "http://127.0.0.1/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
